<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ADCE.Daemon</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADCE.Core\ADCE.Core.csproj" />
    <ProjectReference Include="..\ADCE.Extraction\ADCE.Extraction.csproj" />
    <ProjectReference Include="..\ADCE.Storage\ADCE.Storage.csproj" />
    <ProjectReference Include="..\ADCE.Mcp\ADCE.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ADCE.Daemon.Tests" />
    <InternalsVisibleTo Include="ADCE.Spikes" />
  </ItemGroup>

</Project>
